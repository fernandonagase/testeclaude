# Copie para .env e ajuste. Nunca commite o .env.
NODE_ENV=development
PORT=3000

# docker compose up -d
DATABASE_URL=postgres://collectdex:collectdex@localhost:5432/collectdex
REDIS_URL=redis://localhost:6379

# Auth (doc 04): em dev, tokens "dev:<userId>" são aceitos com a flag abaixo.
# Em staging/prod, configurar o provedor gerenciado e desligar a flag.
AUTH_ALLOW_DEV_TOKEN=true
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
